<Window x:Class="AdvancedNumberGuessing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quantum Guesser // Cyberpunk Edition" Height="780" Width="940"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14"
        FontFamily="Segoe UI Variable, Segoe UI, Roboto, Helvetica">

    <Window.Resources>
        <!-- Glassmorphism Card Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Neon Button Style -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="#1F6FEB" CornerRadius="10" Padding="18,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#388BFD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1158C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Screen Shake Storyboard -->
        <Storyboard x:Key="ShakeAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShakeTransform" Storyboard.TargetProperty="X">
                <EasingDoubleKeyFrame KeyTime="0:0:0.02" Value="-14"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.06" Value="14"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.10" Value="-10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="-5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.26" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShakeTransform" Storyboard.TargetProperty="Y">
                <EasingDoubleKeyFrame KeyTime="0:0:0.02" Value="8"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.06" Value="-8"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.10" Value="6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="-6"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="3"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Particle / Confetti Canvas Layer -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" Panel.ZIndex="99"/>

        <!-- Root Layout Grid with Screen-Shake Transform -->
        <Grid Margin="32">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShakeTransform" X="0" Y="0"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Game Mode Selectors -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="QUANTUM NUMBER GUESSER" Foreground="#58A6FF" FontSize="26" FontWeight="Black"/>
                    <TextBlock Text="Adaptive High-Performance Deduction Engine" Foreground="#8B949E" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Game Mode Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbClassic" Content="Classic" IsChecked="True" Foreground="#C9D1D9" Margin="0,0,12,0" Checked="ModeChanged"/>
                    <RadioButton x:Name="RbTimeAttack" Content="Time Attack" Foreground="#C9D1D9" Margin="0,0,12,0" Checked="ModeChanged"/>
                    <RadioButton x:Name="RbEndurance" Content="Endurance" Foreground="#C9D1D9" Checked="ModeChanged"/>
                </StackPanel>
            </Grid>

            <!-- Central Content: Dashboard & Heat Radar -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Main Game Console Card -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Dynamic Range & Status -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock x:Name="TxtRangeIndicator" Text="TARGET RANGE: [1 — 100]" Foreground="#58A6FF" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="TxtTimer" Text="TIME: 30.0s" HorizontalAlignment="Right" Foreground="#FFA657" FontWeight="Bold" FontSize="14" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Center Guess Interaction Zone -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                            <TextBlock Text="ENTER DEDUCTION" Foreground="#8B949E" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            
                            <!-- Guess Input Box -->
                            <TextBox x:Name="InputGuess" Height="56" FontSize="26" FontWeight="Bold"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     Background="#0D1117" Foreground="#58A6FF" BorderBrush="#30363D"
                                     BorderThickness="2" KeyDown="InputGuess_KeyDown"/>

                            <Button Content="SUBMIT GUESS" Style="{StaticResource NeonButton}" Margin="0,16,0,0" Height="48" Click="SubmitGuess_Click"/>

                            <!-- Feedback Banner -->
                            <Border x:Name="FeedbackBadge" CornerRadius="8" Background="#21262D" Margin="0,20,0,0" Padding="14">
                                <TextBlock x:Name="TxtFeedback" Text="Awaiting first input..." Foreground="#C9D1D9" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Heat Radar / Proximity Visualizer -->
                        <StackPanel Grid.Row="2" Margin="0,24,0,0">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="HEAT RADAR (PROXIMITY METRIC)" Foreground="#8B949E" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtHeatValue" Text="0%" Foreground="#8B949E" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Gradient Proximity Progress Bar -->
                            <Border Height="16" CornerRadius="8" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1">
                                <Grid>
                                    <ProgressBar x:Name="HeatBar" Minimum="0" Maximum="100" Value="0" Height="14"
                                                 BorderThickness="0" Background="Transparent">
                                        <ProgressBar.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00D2FF" Offset="0.0"/>
                                                <GradientStop Color="#00FFA3" Offset="0.3"/>
                                                <GradientStop Color="#FFB800" Offset="0.7"/>
                                                <GradientStop Color="#FF2A54" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </ProgressBar.Foreground>
                                    </ProgressBar>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sidebar: Stats, Multiplier & Attempt Log -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Scoreboard -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="TELEMETRY" Foreground="#8B949E" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,4">
                                <TextBlock Text="Current Score" Foreground="#C9D1D9"/>
                                <TextBlock x:Name="TxtScore" Text="0" Foreground="#58A6FF" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Win Streak" Foreground="#C9D1D9"/>
                                <TextBlock x:Name="TxtStreak" Text="0x" Foreground="#7EE787" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Remaining Attempts" Foreground="#C9D1D9"/>
                                <TextBlock x:Name="TxtAttemptsLeft" Text="7" Foreground="#FFA657" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <Separator Grid.Row="1" Background="#30363D" Margin="0,0,0,14"/>

                        <!-- Attempt History Console -->
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Text="ATTEMPT MATRIX" Foreground="#8B949E" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ListBox x:Name="ListAttempts" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"
                                     Foreground="#C9D1D9" FontSize="12" FontFamily="Consolas, monospace"/>
                        </DockPanel>

                        <!-- Reset / Next Round Button -->
                        <Button Grid.Row="3" Content="NEW ROUND" Style="{StaticResource NeonButton}" Background="#238636"
                                Margin="0,16,0,0" Height="40" Click="NewRound_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer Telemetry -->
            <StatusBar Grid.Row="2" Background="Transparent" Foreground="#8B949E" Margin="0,18,0,0">
                <StatusBarItem Content="Layer: C# Retained WPF Hardware Rendering Engine"/>
                <StatusBarItem HorizontalAlignment="Right" Content="DirectX D3D Acceleration: Active"/>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
